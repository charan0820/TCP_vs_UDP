  "narrative": {
    "northStar": "Signal archive",
    "overview": "The Signal archive turns a network experiment into a readable trail of evidence. A near-black field gives white typography room to lead; a cyan-to-violet signal column establishes the identity. Colored gradient panels explain the mechanism, while the working lab uses compact native controls and clear borders.\n\nSora supplies the large, direct voice; IBM Plex Mono marks technical labels and measured values. The atmosphere is expressive, but every status and recording claim must describe the local simulator honestly. Decorative motion arrives once, then settles so users can inspect the experiment.",
    "keyCharacteristics": [
      "Near-black surfaces with cyan and violet signal light.",
      "Large editorial type paired with precise technical labels.",
      "Colorful explanatory panels and compact operational controls.",
      "Bounded motion, visible focus and honest recording states."
    ],
    "rules": [
      {
        "name": "The Recorded Signal Rule",
        "body": "Packet color always has a text label; animation represents captured events, and a topology preview is identified as a preview.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Sora for narrative and controls; reserve the mono face for telemetry, identifiers, code and compact technical labels.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use tonal layering and borders for working panels. Reserve the luminous field for the landing expression and the violet shadow for primary actions.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the cyan/violet signal identity and near-black workspace consistent across the shell and packet player.",
      "Do provide visible keyboard focus and readable labels alongside packet colors.",
      "Do respect reduced motion: disable decorative transitions and begin playback paused.",
      "Do distinguish topology previews, recorded events, missing captures and truncated captures.",
      "Do use the same selected run for replay and its measured results."
    ],
    "donts": [
      "Don't turn the reference image's fictional memory or security telemetry into product claims.",
      "Don't animate invented packet deliveries or expose Play controls on an empty topology preview.",
      "Don't use the hero's large display treatment for dense editor labels or measured tables.",
      "Don't add persistent decorative movement behind the operational workspace."
    ]
  }
